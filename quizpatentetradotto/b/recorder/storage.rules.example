rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Each upload is stored at question-explanations/{questionId}.
    match /question-explanations/{questionId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == "iuxgWxoauTdc1U6oyB4VxxCOibk2"
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*')
        && request.resource.metadata.questionId == questionId;

      allow delete: if request.auth != null
        && request.auth.uid == "iuxgWxoauTdc1U6oyB4VxxCOibk2";
    }
  }
}
